\RequirePackage{tikz}
\RequirePackage[absolute,overlay]{textpos}

\mode<presentation>
% Background for normal frames
\setbeamertemplate{background canvas}{
  \tikz[remember picture,overlay] 
    \node[anchor=north west, inner sep=0pt] at (current page.north west) {
      \includegraphics[width=\paperwidth]{images/nies-bg.png}
    };
}

% Empty header
\setbeamertemplate{headline}{}

% Optional section name beside the frame number: "Modifiable exposures | 7 / 14".
% Same switch as the JECS theme, so a deck can use \showsectionname with either;
% NIES has no headline, so it goes in the footline. Off by default, and nothing
% is printed on a frame that is not inside a \section.
\newif\ifbeamer@sectionname
\beamer@sectionnamefalse
\newcommand{\showsectionname}{\beamer@sectionnametrue}
\newcommand{\hidesectionname}{\beamer@sectionnamefalse}
%
% Footer with frame number
\setbeamertemplate{footline}
{%
  \leavevmode%
  \hbox{%
    \begin{beamercolorbox}[wd=\paperwidth,ht=2.25ex,dp=1ex,rightskip=1em]{footline}%
      \hfill%
      \usebeamercolor[fg]{page number in head/foot}%
      \usebeamerfont{page number in head/foot}%
      \ifbeamer@sectionname
        \ifx\insertsection\@empty\else\insertsection\hspace{1em}\textbar\hspace{1em}\fi
      \fi
      \insertframenumber{} / \inserttotalframenumber%
      \hspace*{1em}%
    \end{beamercolorbox}%
  }%
}

% Frame title
\setbeamertemplate{frametitle}
{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north west, xshift=1em, yshift=-0.2cm] at (current page.north west) {
      \begin{beamercolorbox}[wd=0.8\paperwidth,ht=2ex,dp=1ex,left]{frametitle}
        \usebeamerfont{frametitle}\insertframetitle%
        \ifx\insertframesubtitle\@empty%
        \else%
          \\[-0.8ex]\usebeamerfont{framesubtitle}\insertframesubtitle%
        \fi%
      \end{beamercolorbox}
    };
  \end{tikzpicture}\vspace{1.5\baselineskip}
}

% customisation for the title page
% Width of the title-page text block. Set it in a deck that writes its
% title without hard \\ breaks, e.g. \setlength{\niestitlewidth}{0.62\textwidth}.
\newlength{\niestitlewidth}
\AtBeginDocument{\ifdim\niestitlewidth=0pt \setlength{\niestitlewidth}{\textwidth}\fi}
\setbeamertemplate{title page}
{
        % \par sits inside each group so a size set in \title{} (e.g.
        % \fontsize{12pt}{14pt}) also sets the line spacing; \raggedright so
        % titles wrap naturally without hard \\ breaks.
        % \niestitlewidth (default: full width, i.e. no change) narrows the
        % title block so naturally wrapped titles stay clear of the green band.
        \raggedright\hyphenpenalty=10000 \exhyphenpenalty=10000 % no hyphenated titles
        \rightskip=\dimexpr\linewidth-\niestitlewidth\relax plus 1fil
        {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}
        \medskip
        {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}
        \bigskip
        \usebeamerfont{date}\insertdate\par
        \bigskip
        \usebeamerfont{author}\insertauthor\par
        \medskip
        \usebeamerfont{institute}\insertinstitute\par
}

% Custom title page frame macro
\newcommand{\titleframe}{
  \begingroup
    \setbeamertemplate{background canvas}{
      \tikz[remember picture,overlay] \node[anchor=north east, inner sep=0pt] at (current page.north east) {
        \includegraphics[height=\paperheight]{images/nies-title.png}
      };
    }
    \begin{frame}[plain,noframenumbering]
      \titlepage
    \end{frame}
  \endgroup
}

\renewcommand{\familydefault}{\rmdefault} % or \sfdefault
\renewcommand\footnoterule{}
\newcommand\ftnote[1]{%
	\begin{textblock*}{\linewidth}(20pt, 248pt)
		{\color{gray}
		\fontsize{6pt}{7.5pt}\selectfont #1}
	\end{textblock*}
}
\mode<all>